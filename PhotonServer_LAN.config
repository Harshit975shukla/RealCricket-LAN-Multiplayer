<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <!-- Master Server Configuration -->
  <MasterServer>
    <IPAddress>0.0.0.0</IPAddress>
    <Port>5055</Port>
    <MaxMessageSize>512000</MaxMessageSize>
    <MaxQueuedBuffers>10000</MaxQueuedBuffers>
    <MaxPendingBuffers>5000</MaxPendingBuffers>
    <MaxBuffers>20000</MaxBuffers>
    <LogGuardOn>True</LogGuardOn>
  </MasterServer>

  <!-- Game Server Configuration -->
  <GameServer>
    <IPAddress>0.0.0.0</IPAddress>
    <Port>5056</Port>
    <MaxMessageSize>512000</MaxMessageSize>
    <MaxQueuedBuffers>10000</MaxQueuedBuffers>
    <MaxPendingBuffers>5000</MaxPendingBuffers>
    <MaxBuffers>20000</MaxBuffers>
    <LogGuardOn>True</LogGuardOn>
  </GameServer>

  <!-- WebSocket Server (Optional, for web clients) -->
  <WebSocketServer>
    <Enabled>False</Enabled>
    <IPAddress>0.0.0.0</IPAddress>
    <Port>5057</Port>
    <MaxMessageSize>512000</MaxMessageSize>
  </WebSocketServer>

  <!-- Name Server (Disabled for pure LAN) -->
  <NameServer>
    <Enabled>False</Enabled>
    <IPAddress>0.0.0.0</IPAddress>
    <Port>5058</Port>
  </NameServer>

  <!-- Runtime Configuration -->
  <Runtime>
    <Assembly>PhotonHostRuntime, Culture=neutral</Assembly>
    <Type>PhotonHostRuntime.PhotonDomainManager</Type>
    <UnobservedExceptionHandler>PhotonHostRuntime.UnobservedExceptionHandler</UnobservedExceptionHandler>
    <DefaultAppDomain>True</DefaultAppDomain>
    <EnablePerformanceCounters>True</EnablePerformanceCounters>
    <DataRoot>..\..\..\data</DataRoot>
    <LogRoot>..\..\..\log</LogRoot>
    <ConfigRoot>..\..\..\config</ConfigRoot>
    <TempRoot>..\..\..\tmp</TempRoot>
  </Runtime>

  <!-- Applications -->
  <Applications Default="Master">
    <Application Name="Master" BaseDirectory="..\..\..\deploy\Master" Assembly="Master" Type="Photon.LoadBalancing.MasterServer.MasterApplication" ForceAutoStart="True" StartTimeout="60000" StopTimeout="60000" />
    <Application Name="Game" BaseDirectory="..\..\..\deploy\GameServer" Assembly="GameServer" Type="Photon.LoadBalancing.GameServer.GameApplication" ForceAutoStart="True" StartTimeout="60000" StopTimeout="60000" />
  </Applications>

  <!-- Logging Configuration -->
  <Loggers>
    <Logger Name="Photon" Level="INFO" />
    <Logger Name="Photon.LoadBalancing" Level="INFO" />
    <Logger Name="Photon.LoadBalancing.MasterServer" Level="INFO" />
    <Logger Name="Photon.LoadBalancing.GameServer" Level="INFO" />
    <Logger Name="Photon.SocketServer" Level="INFO" />
  </Loggers>

  <!-- LAN-Specific Settings -->
  <LAN>
    <Enabled>True</Enabled>
    <DisableNameServer>True</DisableNameServer>
    <AllowDirectGameServerConnection>True</AllowDirectGameServerConnection>
    <MasterServerAddress>127.0.0.1:5055</MasterServerAddress>
    <GameServerAddress>127.0.0.1:5056</GameServerAddress>
    <UseTcpForGameServer>False</UseTcpForGameServer>
  </LAN>
</Configuration>